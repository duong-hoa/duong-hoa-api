# ============================================================
# DKAS backend (NestJS + Prisma) — standalone service.
# Runs against its OWN Postgres database (see docker-compose.yml),
# separate from the Next.js app's database.
# ============================================================

PORT=4000

# Own Postgres instance (docker-compose service name: db)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=dkas_backend
DATABASE_URL=postgresql://postgres:replace-with-a-long-random-password@db:5432/dkas_backend

DB_HOST_PORT=23436
API_HOST_PORT=32414

# JWT auth (bearer tokens). Real accounts now live in the admin_users table
# (bcrypt-hashed passwords) — manage them at /admin/accounts once logged in.
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRES_IN=8h

# Bootstrap-only: read exactly once by `npm run prisma:seed` to create the
# FIRST admin_users row when the table is empty (there is no other way to
# log in before that). Not checked at request time, unlike the old
# ADMIN_EMAIL/ADMIN_PASSWORD. Safe to unset after the first successful
# login — manage further accounts (and change this one's password) via
# /admin/accounts instead.
SEED_ADMIN_EMAIL=dkas@gmail.com
SEED_ADMIN_PASSWORD=Admin@321
SEED_ADMIN_NAME=Admin

# Media uploads (src/storage/S3StorageService) go straight to an S3 or
# S3-compatible bucket — this server never writes them to its own disk.
# Self-hosted (MinIO or similar): set S3_ENDPOINT to that service's API URL
# and S3_FORCE_PATH_STYLE=true. Real AWS S3: leave both empty/false.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=replace-with-your-bucket-name
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=true
# Public base URL uploaded files are reachable at (the bucket's own public
# URL, or a CDN/custom domain in front of it) — used to build the full link
# returned by the upload endpoint. No trailing slash.
S3_PUBLIC_BASE_URL=https://your-bucket-public-url.example.com

# This backend's own public origin (the domain/port it's reachable at from
# the outside) — still used to resolve any other stored relative path (e.g.
# legacy content) into an absolute URL in API responses, separately from
# S3_PUBLIC_BASE_URL above. Must match the frontend's
# NEXT_PUBLIC_ASSET_BASE_URL/BACKEND_API_URL (same backend, same value).
NEXT_PUBLIC_ASSET_BASE_URL=https://api.example.com

# Optional runtime analytics / AI integrations.
GA_PROPERTY_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GEMINI_API_KEY=
