# ============================================================
# DKAS backend (NestJS + Prisma) — standalone service.
# Runs against its OWN Postgres database (see docker-compose.yml),
# separate from the Next.js app's database.
# ============================================================

PORT=4000

# Own Postgres instance (docker-compose service name: db)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=dkas_backend
DATABASE_URL=postgresql://postgres:replace-with-a-long-random-password@db:5432/dkas_backend

DB_HOST_PORT=23436
API_HOST_PORT=32414

# JWT auth (bearer tokens). Mirrors the Next.js app's Auth.js JWT session
# strategy: single fixed admin account, 8h session lifetime, plain-text
# password compare against ADMIN_PASSWORD (not hashed) to match current
# behavior exactly.
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRES_IN=8h
# Must match the dieu-khac-anh-sang frontend's ADMIN_EMAIL/ADMIN_PASSWORD
# exactly — it logs into this backend server-to-server with the same
# fixed admin account (see src/lib/backend-client.ts there).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password

# S3-compatible storage for media uploads.
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=dkas-media
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me

# Optional runtime analytics / AI integrations.
GA_PROPERTY_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GEMINI_API_KEY=
